# ==============================================================================
# Grund GLP Environment Configuration Example
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
# ==============================================================================

# --- LLM & Embedding Credentials ---
OPENAI_API_KEY=""
LITELLM_API_KEY=""
LITELLM_API_BASE=""
HF_TOKEN=""

# --- Model Selection Defaults ---
LLM_MODEL="openai/gpt-4o-mini"
EMBED_MODEL="sentence-transformers/all-MiniLM-L6-v2"
RERANKER_MODEL="Alibaba-NLP/gte-reranker-modernbert-base"

# --- Neo4j Graph Database ---
NEO4J_URL="bolt://127.0.0.1:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"
NEO4J_DATABASE="neo4j"

# --- Observability (Langfuse) ---
# Default keys provisioned automatically when running via docker compose:
# LANGFUSE_PUBLIC_KEY="pk-lf-episteme-public"
# LANGFUSE_SECRET_KEY="sk-lf-episteme-secret"
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="http://localhost:3000"

# --- Local Inference Engines ---
OLLAMA_HOST="http://localhost:11434"
